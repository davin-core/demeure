# Reference for PowerShell or deployment configuration.
# ASP.NET Core does not automatically load .env files.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5076
AllowedHosts=localhost;127.0.0.1

# Production: supply the real connection with secrets via environment/user-secrets.
Database__Provider=PostgreSQL
# ConnectionStrings__Demeure=Host=localhost;Database=demeure;Username=demeure;Password=...

# EF CLI uses DEMEURE_POSTGRES_CONNECTION or DEMEURE_SQLITE_CONNECTION.
# PostgreSQL API runtime login must not be superuser/BYPASSRLS/schema owner.
# Keep privileged migration credentials separate from runtime configuration.
# Live RLS tests only: dedicated server admin via local secrets/environment.
# DEMEURE_TEST_POSTGRES_ADMIN=configure-via-local-secret-manager

# Account email: Development defaults to real, ignored .eml pickup files.
# Production requires SMTP with STARTTLS, a verified sender and protected credentials.
# AccountEmail__Delivery=Smtp
# AccountEmail__Host=smtp.your-provider.example
# AccountEmail__Port=587
# AccountEmail__From=no-reply@your-domain.example
# AccountEmail__UserName=configure-via-secret-manager
# AccountEmail__Password=configure-via-secret-manager
