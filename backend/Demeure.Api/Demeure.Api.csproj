<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>demeure-api-development</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <ProjectReference Include="..\Demeure.Application\Demeure.Application.csproj" />
    <ProjectReference Include="..\Demeure.Infrastructure\Demeure.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="node_modules\swagger-ui-dist\swagger-ui-bundle.js;node_modules\swagger-ui-dist\swagger-ui.css">
      <Link>SwaggerAssets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Documentation\swagger-init.js">
      <Link>SwaggerAssets\swagger-init.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="node_modules\swagger-ui-dist\LICENSE">
      <Link>SwaggerAssets\LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateSwaggerAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('node_modules\swagger-ui-dist\swagger-ui-bundle.js')"
           Text="Swagger UI assets are missing. Run npm ci --prefix backend\Demeure.Api from the repository root." />
  </Target>

</Project>
