{
  "AccountEmail": {
    "Delivery": "Pickup",
    "From": "no-reply@demeure.local",
    "PickupDirectory": ""
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Demeure": "Data Source=demeure.db;Foreign Keys=True"
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "HH:mm:ss "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
