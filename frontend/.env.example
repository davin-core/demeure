# Public browser configuration. Never place secrets in VITE_* variables.
# Use /api for same-origin development and production reverse proxies.
# /api/v1 is also accepted; health probes remain unversioned.
VITE_API_BASE_URL=/api

# Vite dev/preview server only; not exposed to the browser.
# Production hosting must route /api to the API separately; Vite is not the production server.
API_PROXY_TARGET=http://localhost:5076
